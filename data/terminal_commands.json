  },
  {
    "system": "linux",
    "category": "文件",
    "title": "权限格式",
    "syntax": "chmod [权限] [文件]",
    "example": "chmod u+x /tmp/script.sh",
    "description": "修改指定文件权限，先检查路径。"
  },
  {
    "system": "linux",
    "category": "系统",
    "title": "系统版本",
    "syntax": "uname [-a]",
    "example": "uname -a",
    "description": "查看内核和架构。"
  },
  {
    "system": "linux",
    "category": "系统",
