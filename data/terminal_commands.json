    "syntax": "pwd",
    "example": "pwd",
    "description": "显示当前工作目录。"
  },
  {
    "system": "linux",
    "category": "文件",
    "title": "切换目录",
    "syntax": "cd [目录]",
    "example": "cd /tmp",
