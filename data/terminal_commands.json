[
  {
    "system": "linux",
    "category": "文件",
    "title": "列出目录",
    "syntax": "ls [-alh] [目录]",
    "example": "ls -alh /tmp",
    "description": "查看文件、权限、大小与隐藏项目。"
  },
  {
    "system": "linux",
    "category": "文件",
