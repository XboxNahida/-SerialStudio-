    "system": "powershell",
    "category": "文件",
    "title": "查看末尾",
    "syntax": "Get-Content -LiteralPath 文件 -Tail 行数",
    "example": "Get-Content -LiteralPath '.\\app.log' -Tail 50",
    "description": "适合日志末尾。"
  },
