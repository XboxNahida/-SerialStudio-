  },
  {
    "system": "powershell",
    "category": "文件",
    "title": "列出目录",
    "syntax": "Get-ChildItem [-Path 路径] [-Force]",
    "example": "Get-ChildItem -Path $env:TEMP -Force",
    "description": "包括隐藏文件。"
  },
  {
    "system": "powershell",
    "category": "文件",
    "title": "当前目录",
    "syntax": "Get-Location",
    "example": "Get-Location",
    "description": "显示当前路径。"
  },
  {
    "system": "powershell",
    "category": "文件",
    "title": "切换目录",
    "syntax": "Set-Location -LiteralPath 路径",
    "example": "Set-Location -LiteralPath $env:TEMP",
    "description": "支持带空格的路径。"
  },
  {
    "system": "powershell",
    "category": "文件",
    "title": "读取 UTF-8 文本",
    "syntax": "Get-Content -LiteralPath 文件 -Encoding UTF8",
    "example": "Get-Content -LiteralPath '.\\日志.txt' -Encoding UTF8",
    "description": "按 UTF-8 解码文本。"
  },
  {
    "system": "powershell",
    "category": "文件",
    "title": "搜索文本",
    "syntax": "Select-String -Path 文件 -Pattern 关键词",
    "example": "Select-String -Path '.\\*.log' -Pattern 'error'",
    "description": "输出匹配行。"
  },
  {
    "system": "powershell",
    "category": "文件",
    "title": "递归查找",
    "syntax": "Get-ChildItem -Path 目录 -Filter 模式 -Recurse",
    "example": "Get-ChildItem -Path $env:TEMP -Filter '*.log' -Recurse",
    "description": "目录较大时可能耗时。"
  },
  {
    "system": "powershell",
    "category": "文件",
    "title": "文件哈希",
    "syntax": "Get-FileHash -LiteralPath 文件 -Algorithm SHA256",
    "example": "Get-FileHash -LiteralPath '.\\data.bin' -Algorithm SHA256",
    "description": "校验文件完整性。"
  },
