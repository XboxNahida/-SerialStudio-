  },
  {
    "system": "linux",
    "category": "文件",
    "title": "读取文本",
    "syntax": "cat [文件]",
    "example": "cat /etc/os-release",
    "description": "适合小型文本文件；大文件可用 less。"
  },
  {
    "system": "linux",
    "category": "文件",
    "title": "搜索内容",
    "syntax": "grep -n [关键词] [文件]",
    "example": "grep -n 'root' /etc/passwd",
    "description": "显示匹配文本及行号。"
  },
  {
    "system": "linux",
    "category": "文件",
    "title": "查找文件",
    "syntax": "find [目录] -name [名称]",
    "example": "find /tmp -name '*.log'",
